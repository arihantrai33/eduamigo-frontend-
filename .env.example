# Backend API base URL, ending in /api (no trailing slash).
# Local development: keep "/api"; Vite forwards it to http://localhost:8000 (see vite.config.js).
# Production (Vercel): set VITE_API_URL to the Render URL, e.g. https://your-backend.onrender.com/api
VITE_API_URL=/api

# A school's own address (optional; off unless VITE_TENANT_ROUTING=on). See docs/audit/AUTH_AUDIT.md.
#   Locally: VITE_TENANT_ROUTING=on VITE_PLATFORM_BASE_DOMAIN=localhost, and PLATFORM_BASE_DOMAIN=localhost on the backend,
#   then open http://gvps.localhost:5173/login (Chrome sends *.localhost to this machine).
# VITE_TENANT_ROUTING=on
# VITE_PLATFORM_BASE_DOMAIN=eduamigo.com
# VITE_PLATFORM_HOSTS=eduamigo.com,www.eduamigo.com
