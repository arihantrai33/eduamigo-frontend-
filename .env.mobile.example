# Copy to .env.mobile (git-ignored) and set the API address the apps should use. No secrets go here:
# everything in a VITE_ variable is visible inside the app.
#   Android emulator against the local demo backend:  VITE_API_URL=http://10.0.2.2:8000/api   (with CAP_LOCAL_DEV=true)
#   iOS simulator against the local demo backend:     VITE_API_URL=http://localhost:8000/api   (with CAP_LOCAL_DEV=true)
#   Release:                                          VITE_API_URL=https://<your API host>/api
VITE_API_URL=
